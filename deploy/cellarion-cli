#!/usr/bin/env python3
"""cellarion — Cellarion wine cellar (https://wines.exerun.com) for Cleo, agents and JB (DEV-70).

Talks to Cellarion's MCP endpoint with a personal API token (scopes read+write+consume). The token
is read from ~/.config/cellarion/token (must be mode 600) and only ever sent as a header; it never
appears on a command line or in output. Every command prints JSON.

  cellarion price-lookup <wine_id> [--vintage V]  dry run: structured retail offers and pick
  cellarion set-price <wine_id> <vintage> <dkk> --source SOURCE [--notes TEXT]
                                              estimate via dedicated pricebot token, currency DKK
  cellarion ping                              token works? (whoami + token scopes)
  cellarion list-cellars                      cellars: id, name, bottle count
  cellarion create-cellar <name>              new cellar (only if JB has none yet; undoable)
  cellarion racks <cellar_id>                 racks in a cellar: id, name, layout, free/used slots
  cellarion search [query] [--cellar ID] [--vintage V] [--status active|consumed|on_order|all] [--limit N]
  cellarion resolve --name N [--producer P] [--country C] [--type T] [--vintage V] [--region R]
                                              registry lookup before adding (creates nothing)
  cellarion add --cellar ID <items.json|->    PREVIEW a batch (nothing written). Items: list of
                                              {wine_id | new_wine{...}, vintage, quantity, drink_from,
                                               drink_to, price, currency, notes, confirm_new_wine}
                                              quantity n expands to n bottles; max 24 bottles/batch.
  cellarion add --apply <preview_id>          write the previewed batch (one undo unit)
  cellarion photo <image> (--bottle ID | --wine ID) [--label-only]   attach the shelf/label photo
  cellarion place <rack_id> <position> <bottle_id>                   put a bottle in a rack slot
  cellarion undo-last                         undo the newest MCP change on the account
  cellarion undo-last --batch                 undo everything this CLI did since (and incl.) the last
                                              `add --apply` — the photo, placements, then the batch
  cellarion journal                           what this CLI wrote, newest last (local record)
  cellarion cellar [--cellar ID] [--all]      READ ONLY (DEV-73): the drinkable cellar in one call — wines
                                              in stock grouped by wine+vintage with quantity, rack position
                                              and drink window; `window` is in|approaching|past|unknown
                                              (--all adds not_yet and reserved bottles). Chef/Ray/Cleo use
                                              this for food pairing, with the read-only token.

Token file: $CELLARION_TOKEN_FILE overrides the default. ~/.config/cellarion/token-read holds a token
with scope `read` only — every write verb fails on it server-side.

Exit codes: 0 ok, 1 API/tool error, 2 usage, 3 token missing/unsafe.
"""
import base64
import math
import json
import os
import stat
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

BASE = os.environ.get("CELLARION_URL", "https://wines.exerun.com").rstrip("/")
TOKEN_FILE = Path(os.environ.get("CELLARION_TOKEN_FILE", Path.home() / ".config/cellarion/token"))
STATE = Path(os.environ.get("CELLARION_STATE_DIR", Path.home() / ".local/state/cellarion"))
JOURNAL = STATE / "journal.jsonl"
MAX_BATCH = 24


def out(obj, code=0):
    print(json.dumps(obj, indent=2, ensure_ascii=False, default=str))
    sys.exit(code)


def die(msg, code=1, **extra):
    print(json.dumps({"ok": False, "error": msg, **extra}, indent=2, ensure_ascii=False), file=sys.stderr)
    sys.exit(code)


def token():
    try:
        st = TOKEN_FILE.stat()
    except FileNotFoundError:
        die(f"no token file {TOKEN_FILE} — create a personal API token in Cellarion and save it there (mode 600)", 3)
    if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        die(f"{TOKEN_FILE} is readable by others (mode {oct(st.st_mode & 0o777)}) — chmod 600 it; refusing to run", 3)
    if st.st_uid != os.getuid():
        die(f"{TOKEN_FILE} is not owned by this user; refusing to run", 3)
    t = TOKEN_FILE.read_text().strip()
    if not t.startswith("cel_"):
        die(f"{TOKEN_FILE} does not hold a Cellarion API token (cel_…)", 3)
    return t


_rpc_id = 0


def mcp(tool, args=None):
    """Stateless MCP tools/call. Returns the tool's parsed {summary, data, ...}; dies on any error."""
    global _rpc_id
    _rpc_id += 1
    body = {"jsonrpc": "2.0", "id": _rpc_id, "method": "tools/call", "params": {"name": tool, "arguments": args or {}}}
    req = urllib.request.Request(
        BASE + "/api/mcp", method="POST", data=json.dumps(body).encode(),
        headers={
            "Authorization": "Bearer " + token(),
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "User-Agent": "cellarion-cli/1 (theo ~/ops/bin/cellarion)",
        })
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            raw = r.read().decode()
            ctype = r.headers.get("Content-Type", "")
    except urllib.error.HTTPError as e:
        die(f"Cellarion answered HTTP {e.code}", 1, body=e.read().decode(errors="replace")[:400])
    except urllib.error.URLError as e:
        die(f"cannot reach {BASE}: {e.reason}")
    if "text/event-stream" in ctype:
        msgs = [json.loads(l[5:]) for l in raw.splitlines() if l.startswith("data:") and l[5:].strip()]
        msg = next((m for m in msgs if m.get("id") == _rpc_id), msgs[-1] if msgs else {})
    else:
        msg = json.loads(raw)
    if "error" in msg:
        die(f"MCP error: {msg['error'].get('message')}", 1, tool=tool)
    res = msg.get("result", {})
    text = "".join(c.get("text", "") for c in res.get("content", []) if c.get("type") == "text")
    try:
        parsed = json.loads(text)
    except ValueError:
        parsed = {"summary": text}
    if res.get("isError"):
        die(parsed.get("summary") or parsed.get("message") or text, 1, tool=tool, detail=parsed)
    return parsed


def journal_add(tool, summary, **ids):
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with JOURNAL.open("a") as f:
        f.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "tool": tool, "summary": summary, **ids}) + "\n")


def journal_read():
    if not JOURNAL.exists():
        return []
    return [json.loads(l) for l in JOURNAL.read_text().splitlines() if l.strip()]


def journal_write(rows):
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = JOURNAL.with_suffix(".new")
    tmp.write_text("".join(json.dumps(r) + "\n" for r in rows))
    tmp.replace(JOURNAL)


def opt(argv, name, default=None, flag=False):
    if name in argv:
        i = argv.index(name)
        if flag:
            argv.pop(i)
            return True
        if i + 1 >= len(argv):
            die(f"{name} needs a value", 2)
        v = argv[i + 1]
        del argv[i:i + 2]
        return v
    return False if flag else default


def expand(items):
    """quantity n → n identical bulk_add items (the server adds one bottle per item)."""
    if not isinstance(items, list) or not items:
        die("items must be a non-empty JSON list", 2)
    flat = []
    for i, it in enumerate(items):
        it = dict(it)
        q = it.pop("quantity", 1)
        if not isinstance(q, int) or q < 1:
            die(f"item {i}: quantity must be a positive integer", 2)
        if "vintage" in it and it["vintage"] is not None:
            it["vintage"] = str(it["vintage"])
        flat.extend(dict(it) for _ in range(q))
    if len(flat) > MAX_BATCH:
        die(f"{len(flat)} bottles in this batch — max {MAX_BATCH}; split it", 2)
    return flat


NEAR_YEARS = 2  # "approaching": window opens within this many years (same horizon as Cellarion's own)


def window_of(m, year):
    """Classify a search_bottles `maturity` block against the current year."""
    f, t = (m or {}).get("drink_from"), (m or {}).get("drink_to")
    if f is None and t is None:
        return {"window": "unknown", "in_window": None, "drink_window": None}
    if f is not None and year < f:
        state = "approaching" if f - year <= NEAR_YEARS else "not_yet"
        return {"window": state, "in_window": False, "drink_window": f"{f or ''}–{t or ''}", "opens_in_years": f - year}
    if t is not None and year > t:
        return {"window": "past", "in_window": False, "drink_window": f"{f or ''}–{t}", "ended_years_ago": year - t}
    return {"window": "in", "in_window": True, "drink_window": f"{f or ''}–{t or ''}"}


def all_pages(args):
    rows, off = [], 0
    while True:
        r = mcp("search_bottles", {**args, "limit": 50, "offset": off})
        rows += r.get("data", [])
        off += 50
        if off >= r.get("page", {}).get("total", 0):
            return rows


def cellar_view(only_cellar=None, show_all=False):
    year = time.localtime().tm_year
    cellars = [c for c in mcp("list_cellars").get("data", []) if not only_cellar or c["cellar_id"] == only_cellar]
    where, lots, reserved_ids = {}, {}, set()
    counts = {"in_stock": 0, "listed": 0, "reserved": 0, "not_yet": 0}
    for c in cellars:
        for rack in mcp("list_racks", {"cellar_id": c["cellar_id"]}).get("data", []):
            full = mcp("get_rack", {"rack_id": rack["rack_id"]}).get("data", {})
            for s in full.get("slots", []):
                pos = s["position"]
                loc = " / ".join(x for x in (full.get("group"), full.get("name")) if x) + f" #{pos}"
                if full.get("type", "grid") == "grid" and full.get("cols"):
                    loc += f" (row {(pos - 1) // full['cols'] + 1}, col {(pos - 1) % full['cols'] + 1})"
                where[s["bottle_id"]] = (full.get("name") or "", pos, loc)
        if c.get("active_bottles", 1) == 0:
            continue
        reserved_ids |= {b["bottle_id"] for b in all_pages({"cellar_id": c["cellar_id"], "reserved": "only"})}
        for b in all_pages({"cellar_id": c["cellar_id"], "status": "active"}):
            counts["in_stock"] += 1
            w, m = b.get("wine") or {}, b.get("maturity") or {}
            win = window_of(m, year)
            reserved = b["bottle_id"] in reserved_ids
            counts["reserved"] += reserved
            counts["not_yet"] += win["window"] == "not_yet"
            if not show_all and (reserved or win["window"] == "not_yet"):
                continue
            key = (c["cellar_id"], w.get("producer"), w.get("name"), b.get("vintage"), win["drink_window"], reserved)
            lot = lots.get(key)
            if not lot:
                lot = lots[key] = {
                    "producer": w.get("producer"), "wine": w.get("name"), "vintage": b.get("vintage"),
                    "type": w.get("type"), "grapes": w.get("grapes") or [], "region": w.get("region"),
                    "country": w.get("country"), "quantity": 0, **win, "maturity": m.get("status"),
                    "window_source": m.get("source"), "rating": b.get("rating"), "cellar": c["name"],
                    "locations": [], "unplaced": 0, "bottle_ids": []}
                if reserved:
                    lot["reserved"] = True
            lot["quantity"] += 1
            lot["bottle_ids"].append(b["bottle_id"])
            if b["bottle_id"] in where:
                lot["locations"].append(where[b["bottle_id"]])
            else:
                lot["unplaced"] += 1
    for lot in lots.values():
        lot["locations"] = [loc for _, _, loc in sorted(lot["locations"])]
    rank = {"in": 0, "past": 1, "approaching": 2, "unknown": 3, "not_yet": 4}
    wines = sorted(lots.values(), key=lambda l: (rank[l["window"]], l.get("reserved", False),
                                                  (l["drink_window"] or "~").split("–")[-1] or "~"))
    counts["listed"] = sum(l["quantity"] for l in wines)
    res = {"ok": True, "as_of": time.strftime("%Y-%m-%d"), "cellars": [c["name"] for c in cellars],
           "counts": counts, "wines": wines}
    if not counts["in_stock"]:
        res["note"] = "nothing in stock yet — the cellar is empty / intet på lager endnu"
    elif not wines:
        res["note"] = "bottles in stock, but none inside or near their drink window (try --all)"
    return res


PRICE_TOKEN = Path.home() / ".config/cellarion/token-pricebot"
PRICE_TOOLS = {"get_wine", "get_bottle", "list_cellars", "search_bottles", "set_vintage_price"}


def price_mcp(tool, args=None):
    """Use only the dedicated credential and an explicit tool allowlist."""
    global TOKEN_FILE
    if tool not in PRICE_TOOLS:
        die("tool not allowed for pricebot", 2)
    previous = TOKEN_FILE
    TOKEN_FILE = PRICE_TOKEN
    try:
        return mcp(tool, args)
    finally:
        TOKEN_FILE = previous


def price_bottles():
    rows, offset = [], 0
    while True:
        result = price_mcp("search_bottles", {"status": "active", "limit": 50, "offset": offset})
        rows.extend(result.get("data", []))
        offset += 50
        if offset >= result.get("page", {}).get("total", 0):
            return rows


def invoice_present(wine_id):
    # Inspect every matching owned active bottle of
    # this wine before writing a shared valuation. Never write Bottle.price.
    wine = price_mcp("get_wine", {"wine_id": wine_id}).get("data", {})
    for b in price_bottles():
        identity = b.get("wine") or {}
        if (identity.get("name"), identity.get("producer")) == (wine.get("name"), wine.get("producer")):
            # Treat a non-null price, including zero, as an invoice record.
            if b.get("price") is not None:
                return True
            detail = price_mcp("get_bottle", {"bottle_id": b["bottle_id"]}).get("data", {})
            if detail.get("price") is not None:
                return True
    return False


def set_price(wine_id, vintage, amount, source, notes=""):
    if not math.isfinite(amount) or amount <= 0 or len(source) > 100 or not source.startswith("skøn: "):
        die("price must be positive and finite; source must start with 'skøn: ' and be <=100 characters", 2)
    if len(notes) > 2000:
        die("somm_notes exceeds 2000 characters", 2)
    if invoice_present(wine_id):
        die("invoice price exists for this wine; skipping estimate")
    result = price_mcp("set_vintage_price", {"wine_id": wine_id, "vintage": vintage,
                        "price": amount, "currency": "DKK", "source": source, "somm_notes": notes})
    journal_add("set_vintage_price", result.get("summary"), wine_id=wine_id, vintage=vintage,
                credential="pricebot", price_entry_id=result.get("data", {}).get("price_entry_id"))
    return result


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        sys.exit(0 if argv else 2)
    cmd, argv = argv[0], argv[1:]

    if cmd == "price-lookup":
        vintage = opt(argv, "--vintage")
        if len(argv) != 1:
            die("usage: cellarion price-lookup <wine_id> [--vintage V]", 2)
        from cellarion_pricebot import lookup
        wine = mcp("get_wine", {"wine_id": argv[0]}).get("data", {})
        result = lookup(wine, vintage)
        journal_add("price_lookup", "dry run; no remote change", wine_id=argv[0], vintage=vintage,
                    read_only=True)
        out(result)

    if cmd == "set-price":
        source = opt(argv, "--source")
        notes = opt(argv, "--notes", "")
        if len(argv) != 3 or not source:
            die("usage: cellarion set-price <wine_id> <vintage> <dkk> --source SOURCE [--notes TEXT]", 2)
        try:
            amount = float(argv[2])
        except ValueError:
            die("dkk must be a number", 2)
        out(set_price(argv[0], argv[1], amount, source, notes))

    if cmd == "ping":
        cellars = mcp("list_cellars")
        out({"ok": True, "url": BASE, "cellars": cellars.get("summary")})

    if cmd == "list-cellars":
        out(mcp("list_cellars"))

    if cmd == "create-cellar":
        if len(argv) != 1:
            die("usage: cellarion create-cellar <name>", 2)
        r = mcp("create_cellar", {"name": argv[0]})
        journal_add("create_cellar", r.get("summary"), cellar_id=r.get("data", {}).get("cellar_id"))
        out(r)

    if cmd == "racks":
        if len(argv) != 1:
            die("usage: cellarion racks <cellar_id>", 2)
        out(mcp("list_racks", {"cellar_id": argv[0]}))

    if cmd == "search":
        args = {}
        for k, flag in (("cellar_id", "--cellar"), ("vintage", "--vintage"), ("status", "--status")):
            v = opt(argv, flag)
            if v:
                args[k] = v
        lim = opt(argv, "--limit")
        if lim:
            args["limit"] = int(lim)
        if argv:
            args["query"] = " ".join(argv)
        out(mcp("search_bottles", args))

    if cmd == "resolve":
        args = {}
        for k in ("name", "producer", "country", "type", "vintage", "region", "appellation"):
            v = opt(argv, "--" + k)
            if v:
                args[k] = v
        if argv or "name" not in args:
            die("usage: cellarion resolve --name N [--producer P] [--country C] [--type T] [--vintage V]", 2)
        out(mcp("resolve_wine", args))

    if cmd == "add":
        pid = opt(argv, "--apply")
        if pid:
            if argv:
                die("usage: cellarion add --apply <preview_id>", 2)
            r = mcp("bulk_add", {"mode": "apply", "preview_id": pid})
            d = r.get("data", {})
            journal_add("bulk_add", r.get("summary"), preview_id=pid, bottle_ids=d.get("added_bottle_ids", []))
            out(r)
        cellar = opt(argv, "--cellar")
        if not cellar or len(argv) != 1:
            die("usage: cellarion add --cellar <cellar_id> <items.json|->", 2)
        raw = sys.stdin.read() if argv[0] == "-" else Path(argv[0]).read_text()
        items = expand(json.loads(raw))
        r = mcp("bulk_add", {"mode": "preview", "cellar_id": cellar, "items": items})
        r["bottles_in_batch"] = len(items)
        r["next"] = "show this plan to JB; after he confirms: cellarion add --apply <preview_id>"
        out(r)

    if cmd == "photo":
        label_only = opt(argv, "--label-only", flag=True)
        bottle, wine = opt(argv, "--bottle"), opt(argv, "--wine")
        if len(argv) != 1 or bool(bottle) == bool(wine):
            die("usage: cellarion photo <image> (--bottle ID | --wine ID) [--label-only]", 2)
        args = {"image_base64": base64.b64encode(Path(argv[0]).read_bytes()).decode()}
        args["bottle_id" if bottle else "wine_id"] = bottle or wine
        if label_only:
            args["label_only"] = True
        r = mcp("attach_bottle_image", args)
        journal_add("attach_bottle_image", r.get("summary"), bottle_id=bottle, wine_id=wine)
        out(r)

    if cmd == "place":
        if len(argv) != 3:
            die("usage: cellarion place <rack_id> <position> <bottle_id>", 2)
        r = mcp("place_bottle", {"rack_id": argv[0], "position": int(argv[1]), "bottle_id": argv[2]})
        journal_add("place_bottle", r.get("summary"), rack_id=argv[0], position=int(argv[1]), bottle_id=argv[2])
        out(r)

    if cmd == "undo-last":
        batch = opt(argv, "--batch", flag=True)
        if argv:
            die("usage: cellarion undo-last [--batch]", 2)
        rows = [r for r in journal_read() if not r.get("read_only")]
        if rows and rows[-1].get("credential") == "pricebot":
            global TOKEN_FILE
            TOKEN_FILE = PRICE_TOKEN
        if not batch:
            r = mcp("undo_last")
            if rows and rows[-1]["tool"] == r.get("data", {}).get("undone"):
                rows.pop()
                journal_write(rows)
            out(r)
        # --batch: pop this CLI's own actions newest-first down to (and incl.) the last bulk_add.
        # undo_last is account-wide, so each step checks it undid the tool we expected and stops if not.
        idx = max((i for i, x in enumerate(rows) if x["tool"] == "bulk_add"), default=None)
        if idx is None:
            die("no `add --apply` batch in the journal to undo", 1)
        done = []
        while len(rows) > idx:
            want = rows[-1]
            TOKEN_FILE = PRICE_TOKEN if want.get("credential") == "pricebot" else Path(os.environ.get("CELLARION_TOKEN_FILE", Path.home() / ".config/cellarion/token"))
            r = mcp("undo_last")
            got = r.get("data", {}).get("undone")
            done.append({"expected": want["tool"], "undone": got, "summary": r.get("summary")})
            if got != want["tool"]:
                die("undo_last reverted something other than this CLI's last action — stopped; check the app",
                    1, steps=done)
            rows.pop()
            journal_write(rows)
        out({"ok": True, "undone_steps": done})

    if cmd == "cellar":
        show_all = opt(argv, "--all", flag=True)
        only = opt(argv, "--cellar")
        if argv:
            die("usage: cellarion cellar [--cellar ID] [--all]", 2)
        out(cellar_view(only, show_all))

    if cmd == "journal":
        out(journal_read())

    die(f"unknown command '{cmd}' — cellarion --help", 2)


if __name__ == "__main__":
    main(sys.argv[1:])
